# SMTP server used by Nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tips@example.com
SMTP_PASS=your_smtp_password

# Sender shown to subscribers
EMAIL_FROM=tips@example.com
EMAIL_FROM_NAME=Football Tips

# Long random secret used to protect /api/send-email
EMAIL_SEND_SECRET=replace_with_a_long_random_secret
